# ---- Sicurezza ----
# Segreto per il cron giornaliero (Vercel lo invia in automatico come "Authorization: Bearer ...")
CRON_SECRET=cambia-questo-valore-lungo-e-casuale
# Segreto per firmare i Magic Link di conferma (se assente usa CRON_SECRET)
MAGIC_LINK_SECRET=
# Accesso all'app (pagina di login). Predefiniti: utente "greco", password "greco2026".
# Impostali per cambiarli. I link di conferma restano accessibili senza login.
APP_USERNAME=
APP_PASSWORD=
# Segreto per firmare la sessione di accesso (se assente usa CRON_SECRET)
SESSION_SECRET=
# Indirizzo pubblico dell'app (usato nei link inviati). Su Vercel viene dedotto in automatico.
APP_URL=https://tuo-dominio.it
# Ora italiana da cui parte il controllo (default 8 → con i cron di vercel.json invia alle 08:30)
ALERT_HOUR_ROME=8

# ---- Database ----
# Supabase (consigliato in produzione). Senza queste variabili i dati vanno in data/db.json
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Su Netlify i dati vanno in automatico in Netlify Blobs (nessuna variabile necessaria).
# Percorso alternativo del file JSON (server/VPS/Docker)
DATA_FILE=

# ---- Email: Resend (oppure Brevo) ----
RESEND_API_KEY=
EMAIL_FROM=Scadenziario Pro <avvisi@tuo-dominio.it>

# ---- SMS + WhatsApp: Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15551234567
# In alternativa a TWILIO_SMS_FROM (es. per mittente alfanumerico "Scadenze")
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=+14155238886
# Template WhatsApp approvato (necessario fuori dalla finestra di 24h). Variabili: {{1}} oggetto, {{2}} data, {{3}} link
TWILIO_WHATSAPP_CONTENT_SID=

# ---- In alternativa: Brevo (email, SMS, WhatsApp) ----
BREVO_API_KEY=
BREVO_SMS_SENDER=Scadenze
BREVO_WHATSAPP_SENDER=
BREVO_WHATSAPP_TEMPLATE_ID=
